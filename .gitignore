node_modules/
dist/
build/
release/
*.tsbuildinfo
.DS_Store
.env
.env.local

# Lokale Laufzeitdaten der Entwicklungsinstanz
.data/
*.log

# Aus node_modules erzeugt (scripts/collect-fonts.mjs) – nicht einchecken.
# packages/sdk/src/fonts.ts ist dagegen Quelltext und gehoert ins Repository.
packages/shell/src/renderer/fonts/
packages/shell/src/renderer/fonts.css

# Signierschluessel. Der geheime Schluessel gehoert NIE ins Repository – wer ihn
# hat, kann Updates signieren, die jeder Spiegel bereitwillig installiert.
#
# Keine Ausnahme fuer device.key: der entschluesselt secrets.json und liegt im
# Datenverzeichnis (.data/ in der Entwicklung, /opt/smartmirror/data auf dem
# Geraet), also ohnehin ausserhalb des Repositories. Eine Ausnahme schuetzte
# nichts und machte aus einer versehentlich hierher kopierten Datei einen
# Commit.
minisign.key
*.key

# Python legt Bytecode neben die Skripte in deploy/
__pycache__/
