{
  "id": "weather",
  "name": "Wetter",
  "version": "0.5.0",
  "description": "Aktuelles Wetter und Vorhersage von Open-Meteo, im großen Block Tag für Tag durchgeschaltet, im breiten mit Tagesverlauf. Ohne API-Schlüssel nutzbar.",
  "author": "smartmirror",
  "sizes": [
    "s",
    "m",
    "l",
    "xl"
  ],
  "preferredSize": "l",
  "permissions": [
    "network",
    "commands"
  ],
  "network": {
    "allow": [
      "api.open-meteo.com",
      "geocoding-api.open-meteo.com"
    ]
  },
  "refreshInterval": "15m",
  "configSchema": {
    "type": "object",
    "properties": {
      "location": {
        "type": "string",
        "title": "Ort",
        "description": "Ortsname, z.B. \"Innsbruck\" oder \"Wien, AT\".",
        "default": "Wien",
        "minLength": 2
      },
      "units": {
        "type": "string",
        "title": "Einheiten",
        "enum": [
          "metric",
          "imperial"
        ],
        "enumLabels": [
          "Celsius / km/h",
          "Fahrenheit / mph"
        ],
        "default": "metric"
      },
      "forecastDays": {
        "type": "integer",
        "title": "Tage in der Vorhersage",
        "minimum": 0,
        "maximum": 7,
        "default": 4
      },
      "showWind": {
        "type": "boolean",
        "title": "Wind anzeigen",
        "default": true
      },
      "dwellSeconds": {
        "type": "number",
        "title": "Standzeit einer Karte",
        "description": "Sekunden, bis der nächste Tag kommt. Nur im großen Block, der durchschaltet.",
        "minimum": 2,
        "maximum": 60,
        "step": 0.2,
        "default": 2.6
      },
      "refreshMinutes": {
        "type": "integer",
        "title": "Aktualisierung (Minuten)",
        "minimum": 5,
        "maximum": 180,
        "default": 15
      },
      "showHourly": {
        "type": "boolean",
        "title": "Tagesverlauf zeigen",
        "description": "Balkengrafik der Temperatur über den Tag. Nur im großen und breiten Block.",
        "default": true
      },
      "highlight": {
        "type": "boolean",
        "title": "Als Highlight zeigen",
        "description": "Der Block trägt die eine deckende Fläche der Anordnung. Höchstens ein Block pro Screen – zwei summieren sich hinter dem Glas zum Leuchtfeld.",
        "default": false
      }
    },
    "required": [
      "location"
    ]
  }
}
