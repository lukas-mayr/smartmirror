{
  "name": "smartmirror",
  "version": "0.22.0",
  "private": true,
  "description": "Smartmirror – modulare Anzeige-Software fuer Raspberry Pi hinter einem Zwei-Wege-Spiegel",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "build": "npm run generate && npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "clean": "tsc --build --clean && rm -rf packages/*/dist modules/*/dist dist",
    "dev": "node scripts/dev.mjs",
    "dev:core": "npm run dev --workspace @mirror/core",
    "dev:shell": "npm run dev --workspace @mirror/shell",
    "dev:remote": "npm run dev --workspace @mirror/remote",
    "bundle": "node scripts/bundle.mjs",
    "set-version": "node scripts/set-version.mjs",
    "test": "node --test packages/*/test/*.test.mjs modules/*/test/*.test.mjs",
    "generate": "node scripts/collect-fonts.mjs && node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/varela-round": "^5.3.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "lucide-static": "^0.469.0",
    "typescript": "^5.7.2"
  }
}
