[Unit]
Description=Smartmirror Anzeige (Electron unter cage)
After=mirror-core.service seatd.service
Wants=mirror-core.service seatd.service

[Service]
Type=simple
User=mirror
Group=mirror
WorkingDirectory=/opt/smartmirror/current

# cage ist ein Wayland-Compositor fuer genau ein Fenster: kein Desktop, keine
# Leiste, kein Mauszeiger. Damit bootet der Pi in diese Anwendung statt in eine
# Arbeitsumgebung, aus der heraus ein Browser gestartet wuerde.
# Seat-Verwaltung ueber seatd statt ueber systemd-logind.
#
# wlroots braucht einen "Seat", um an Grafikausgabe und Eingabegeraete zu
# kommen. Der Standardweg dorthin ist logind - das setzt aber eine Login-
# Sitzung voraus, und ein Systemdienst hat keine. Ohne diese Zeile fragt
# libseat zuerst logind, wartet zehn Sekunden auf eine Sitzung, die nie kommt,
# und gibt dann auf.
Environment=LIBSEAT_BACKEND=seatd

# Eigenes Laufzeitverzeichnis statt /run/user/<uid>: das legt sonst nur logind
# an, und der Spiegel soll ohne Benutzeranmeldung starten.
RuntimeDirectory=mirror
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/mirror
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=MIRROR_CORE_URL=http://127.0.0.1:8080
ExecStart=/opt/smartmirror/current/deploy/cage-session.sh

Restart=always
RestartSec=5

# Beenden hart begrenzen. Beobachtet: cage reagierte nach einem gescheiterten
# Backend-Start 90 Sekunden lang nicht auf SIGTERM und musste per SIGKILL
# beendet werden. Das ist nicht nur laestig - es bedroht die Update-Kette:
# der Updater startet beide Dienste neu und gibt dem Healthcheck 90 Sekunden.
# Braucht allein das Beenden so lange, laeuft der Healthcheck ab und der
# Spiegel rollt ein voellig intaktes Update zurueck.
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

# Zugriff auf Grafik und Eingabe. Die Gruppe des seatd-Sockets heisst je nach
# Distribution anders und wird deshalb vom Installer ermittelt und per
# Drop-in-Datei ergaenzt, statt hier geraten zu werden.
SupplementaryGroups=video render input
PrivateTmp=yes
NoNewPrivileges=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mirror-shell

[Install]
# multi-user.target, nicht graphical.target: Raspberry Pi OS Lite erreicht
# graphical.target nie, weil es keinen Display-Manager gibt. Genau das ist
# beabsichtigt - cage zeichnet direkt auf DRM/KMS. Mit graphical.target waere
# die Unit in ein Ziel eingehaengt, das nie kommt: der Dienst startet dann
# nicht und hinterlaesst auch keine Logzeile, weil er nie versucht wurde.
WantedBy=multi-user.target
